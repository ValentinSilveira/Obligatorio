@model IEnumerable<Web.Models.DTOs.PagosDTO.ListadoPagoDTO>

<h2>Filtrar pagos por Usuario</h2>

<a asp-controller="Home" asp-action="Index">Volver al inicio</a>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-danger mt-2">@ViewBag.Mensaje</div>
}

@if (Model != null && Model.Any())
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Tipo de Gasto</th>
                <th>Usuario</th>
                <th>Monto</th>
                <th>Metodo de pago</th>
                <th>Numero recibo</th>
                <th>Descripcion de gasto</th>
                <th>Descripcion de pago</th>
                <th>Fecha de Pago</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pago in Model)
            {
                <tr>
                    <td>@pago.Tipo</td>
                    <td>@pago.UsuarioNombre</td>
                    <td>@pago.Monto</td>
                    <td>@pago.MetodoPago</td>
                    <td>@pago.Recibo</td>
                    <td>@pago.GastoDescripcion</td>
                    <td>@pago.Descripcion</td>
                    <td>@(pago.FechaPago?.ToString("dd/MM/yyyy") ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    @if (ViewBag.IdUsuario != null)
    {
        <div class="alert alert-info mt-3">
            No se encontraron pagos para el usuario con ID @ViewBag.IdUsuario.
        </div>
    }
}
