@using Web.Models.DTOs.UsuariosDTO
@model IEnumerable<ListadoUsuarioDTO>
@{
    ViewData["Title"] = "Index";
}

<h1>Listado de Gastos</h1>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success mt-3" role="alert">
        @TempData["Exito"]
    </div>
}
<h1>Listado de usuarios</h1>

<p>
    <a asp-action="Create">Crear usuario nuevo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                    @* @Html.ActionLink("Edit", "Edit", new { id = item.Id }) | *@
                    @Html.ActionLink("Detalle", "Details", new { id = item.Id }) |
                    @Html.ActionLink("Eliminar", "Delete", new { id = item.Id }) |
                    <a asp-action="CambiarPassword"
                       asp-route-id="@item.Id"
                       class="btn btn-info btn-sm">Cambiar contraseña</a>
            </td>
        </tr>
}
    </tbody>
</table>
<a asp-controller="Home" asp-action="Index" class="btn btn-link mt-3">Volver al inicio</a>
