@model IEnumerable<CasosDeUsos.DTOs.UsuariosDTO.ListadoUsuarioDTO>

@{
    ViewData["Title"] = "Usuarios con Pagos Únicos Superiores";
}

<h1>Usuarios con pagos únicos superiores al monto ingresado</h1>

<form method="get" asp-action="FiltrarPorMonto" class="mb-3">
    <div class="row">
        <div class="col-md-3">
            <label for="montoMinimo">Monto mínimo:</label>
            <input type="number" id="montoMinimo" name="montoMinimo" step="0.01" class="form-control" value="@ViewBag.MontoMinimo" />
        </div>
        <div class="col-md-3 align-self-end">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a asp-action="FiltrarPorMonto" class="btn btn-secondary">Limpiar</a>
        </div>
    </div>
</form>

@if (ViewBag.MontoMinimo != null)
{
    if (Model != null && Model.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Id)</th>
                    <th>@Html.DisplayNameFor(model => model.Email)</th>
                    <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                    <th>@Html.DisplayNameFor(model => model.TotalPagado)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Id)</td>
                        <td>@Html.DisplayFor(modelItem => item.Email)</td>
                        <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                        <td>@Html.DisplayFor(modelItem => item.TotalPagado)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-warning mt-3" role="alert">
            No se encontraron usuarios con pagos únicos superiores a @ViewBag.MontoMinimo.
        </div>
    }
}
