@using CasosDeUsos.DTOs.UsuariosDTO
@model DetalleUsuarioDTO

@{
    ViewData["Title"] = "Delete";
}

<h1>Eliminar</h1>

@if(Model.Id > 0)
{

<div>
    <h4>Detalle Usuario</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>        
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Apellido)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Apellido)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DescripcionRol)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DescripcionRol)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
    </div>
}
else
{
    <span class="alert-danger">@ViewBag.Mensaje</span>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
}
